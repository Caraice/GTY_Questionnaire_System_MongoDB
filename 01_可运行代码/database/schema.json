{
  "app_settings": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "_id",
        "schema_version",
        "secret"
      ],
      "properties": {
        "_id": {
          "bsonType": "string"
        },
        "schema_version": {
          "enum": [
            1
          ]
        },
        "secret": {
          "bsonType": "string",
          "minLength": 64
        }
      }
    }
  },
  "users": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "_id",
        "schema_version",
        "username",
        "password_hash",
        "created_at"
      ],
      "properties": {
        "_id": {
          "bsonType": "string"
        },
        "schema_version": {
          "enum": [
            1
          ]
        },
        "username": {
          "bsonType": "string"
        },
        "password_hash": {
          "bsonType": "string"
        },
        "created_at": {
          "bsonType": "date"
        }
      }
    }
  },
  "sessions": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "_id",
        "schema_version",
        "user_id",
        "token_hash",
        "created_at",
        "expires_at"
      ],
      "properties": {
        "_id": {
          "bsonType": "string"
        },
        "schema_version": {
          "enum": [
            1
          ]
        },
        "user_id": {
          "bsonType": "string"
        },
        "token_hash": {
          "bsonType": "string"
        },
        "created_at": {
          "bsonType": "date"
        },
        "expires_at": {
          "bsonType": "date"
        }
      }
    }
  },
  "surveys": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "_id",
        "schema_version",
        "version",
        "owner_id",
        "share_id",
        "title",
        "description",
        "allow_anonymous",
        "allow_multiple",
        "deadline",
        "status",
        "questions",
        "rules",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "_id": {
          "bsonType": "string"
        },
        "schema_version": {
          "enum": [
            1
          ]
        },
        "version": {
          "bsonType": "int",
          "minimum": 1
        },
        "owner_id": {
          "bsonType": "string"
        },
        "share_id": {
          "bsonType": "string"
        },
        "title": {
          "bsonType": "string",
          "minLength": 1
        },
        "description": {
          "bsonType": "string"
        },
        "allow_anonymous": {
          "bsonType": "bool"
        },
        "allow_multiple": {
          "bsonType": "bool"
        },
        "deadline": {
          "bsonType": [
            "date",
            "null"
          ]
        },
        "status": {
          "enum": [
            "draft",
            "published",
            "closed"
          ]
        },
        "questions": {
          "bsonType": "array",
          "items": {
            "bsonType": "object"
          }
        },
        "rules": {
          "bsonType": "array",
          "items": {
            "bsonType": "object"
          }
        },
        "created_at": {
          "bsonType": "date"
        },
        "updated_at": {
          "bsonType": "date"
        }
      }
    }
  },
  "responses": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "_id",
        "schema_version",
        "survey_id",
        "survey_version",
        "respondent_key",
        "attempt_key",
        "submission_key",
        "anonymous",
        "answers",
        "path",
        "submitted_at"
      ],
      "properties": {
        "_id": {
          "bsonType": "string"
        },
        "schema_version": {
          "enum": [
            1
          ]
        },
        "survey_id": {
          "bsonType": "string"
        },
        "survey_version": {
          "bsonType": "int"
        },
        "respondent_key": {
          "bsonType": "string"
        },
        "respondent_id": {
          "bsonType": [
            "string",
            "null"
          ]
        },
        "attempt_key": {
          "bsonType": "string"
        },
        "submission_key": {
          "bsonType": "string"
        },
        "anonymous": {
          "bsonType": "bool"
        },
        "answers": {
          "bsonType": "object"
        },
        "path": {
          "bsonType": "array",
          "items": {
            "bsonType": "string"
          }
        },
        "submitted_at": {
          "bsonType": "date"
        }
      }
    }
  }
}
